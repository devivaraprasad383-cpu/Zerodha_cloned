# Copy this file to .env and fill in real values. Never commit .env.

# Server
NODE_ENV=development
PORT=3002

# MongoDB connection string (local, Atlas, or Docker Compose service name "mongo")
MONGO_URL=mongodb://127.0.0.1:27017/zerodha-clone

# JWT
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS - comma separated list of allowed origins
CLIENT_ORIGINS=http://localhost:3000,http://localhost:3001

# Market data simulation
PRICE_TICK_INTERVAL_MS=2000

# Demo/seed account (used by scripts/seed.js)
SEED_DEMO_EMAIL=demo@zerodha.local
SEED_DEMO_PASSWORD=Demo@1234
